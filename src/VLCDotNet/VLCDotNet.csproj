<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Managed libvlc P/Invoke bindings.

    Target frameworks:
      net8.0                 -> portable desktop asset (Windows/Linux/macOS, WinUI3, Win32, Avalonia).
                                libvlc is resolved dynamically by name ("libvlc").
      net10.0-android        -> Android head. libvlc.so resolved by name; packaged as AndroidNativeLibrary.
      net10.0-ios            -> iOS head. libvlc is statically linked -> DllImport target "__Internal".
      net10.0-maccatalyst    -> Mac Catalyst head. libvlc.dylib resolved by name.

    Mobile heads are opt-in (VlcMobileTargets=true) so day-to-day `dotnet build`
    on any OS stays fast and does not require the Apple SDK. CI packs on macOS
    with VlcMobileTargets=true to include every head.
  -->
  <PropertyGroup>
    <VlcMobileTargets Condition="'$(VlcMobileTargets)' == ''">false</VlcMobileTargets>

    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(VlcMobileTargets)' == 'true' and $([MSBuild]::IsOSPlatform('OSX'))">net8.0;net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="'$(VlcMobileTargets)' == 'true' and !$([MSBuild]::IsOSPlatform('OSX'))">net8.0;net10.0-android</TargetFrameworks>

    <AssemblyName>VLCDotNet</AssemblyName>
    <RootNamespace>VLCDotNet</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>

    <!-- NuGet packaging (VLCDotNet3) -->
    <IsPackable>true</IsPackable>
    <PackageId>VLCDotNet3</PackageId>
    <Version>$(VlcVersion)</Version>
    <Title>VLCDotNet3 - libvlc 3.x for .NET</Title>
    <Description>Cross-platform libvlc 3.0.x P/Invoke bindings packaged with native VLC binaries for Windows, Linux, macOS, Mac Catalyst, iOS and Android. Usable from .NET MAUI, WinUI 3, Win32, Avalonia and console apps.</Description>
    <PackageTags>vlc;libvlc;video;audio;media;player;maui;avalonia;winui;win32;pinvoke;interop</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Where CI stages the built native runtimes (artifacts/&lt;rid&gt;/...) -->
    <VlcArtifacts Condition="'$(VlcArtifacts)' == ''">$(MSBuildThisFileDirectory)../../artifacts</VlcArtifacts>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.EndsWith('-ios'))">
    <SupportedOSPlatformVersion>12.2</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.EndsWith('-maccatalyst'))">
    <SupportedOSPlatformVersion>13.1</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.EndsWith('-android'))">
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Package metadata / docs / consumer targets -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../PACKAGE-LICENSE.txt" Pack="true" PackagePath="PACKAGE-LICENSE.txt" />
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="README.md" />
    <None Include="$(MSBuildThisFileDirectory)../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="THIRD-PARTY-NOTICES.md" />
    <None Include="$(MSBuildThisFileDirectory)build/VLCDotNet3.targets" Pack="true" PackagePath="build/VLCDotNet3.targets" />
    <None Include="$(MSBuildThisFileDirectory)build/VLCDotNet3.targets" Pack="true" PackagePath="buildTransitive/VLCDotNet3.targets" />
  </ItemGroup>

  <!--
    Desktop native runtimes. The .NET SDK copies runtimes/<rid>/native/** next to
    the consuming app automatically, so libvlc + its plugins/ folder deploy with
    zero extra MSBuild on the desktop. Empty globs (no local build) are fine.
  -->
  <ItemGroup Label="Desktop native runtimes">
    <None Include="$(VlcArtifacts)/win-x64/**/*"      Pack="true" PackagePath="runtimes/win-x64/native/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(VlcArtifacts)/win-arm64/**/*"    Pack="true" PackagePath="runtimes/win-arm64/native/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(VlcArtifacts)/linux-x64/**/*"    Pack="true" PackagePath="runtimes/linux-x64/native/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(VlcArtifacts)/linux-arm/**/*"    Pack="true" PackagePath="runtimes/linux-arm/native/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(VlcArtifacts)/linux-arm64/**/*"  Pack="true" PackagePath="runtimes/linux-arm64/native/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(VlcArtifacts)/osx-x64/**/*"      Pack="true" PackagePath="runtimes/osx-x64/native/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(VlcArtifacts)/osx-arm64/**/*"    Pack="true" PackagePath="runtimes/osx-arm64/native/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Mobile native runtimes live under build/native/<rid> and are wired into the
    consuming mobile app by build/VLCDotNet3.targets (Android .so as native
    libraries; iOS/Catalyst static libvlc linked in). Kept out of runtimes/ so
    they do not clash with the desktop auto-deploy convention.
  -->
  <ItemGroup Label="Mobile native runtimes">
    <None Include="$(VlcArtifacts)/android-arm/**/*"        Pack="true" PackagePath="build/native/android-arm/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(VlcArtifacts)/android-arm64/**/*"      Pack="true" PackagePath="build/native/android-arm64/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(VlcArtifacts)/android-x64/**/*"        Pack="true" PackagePath="build/native/android-x64/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(VlcArtifacts)/ios-arm64/**/*"          Pack="true" PackagePath="build/native/ios-arm64/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(VlcArtifacts)/iossimulator-x64/**/*"   Pack="true" PackagePath="build/native/iossimulator-x64/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(VlcArtifacts)/iossimulator-arm64/**/*" Pack="true" PackagePath="build/native/iossimulator-arm64/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(VlcArtifacts)/maccatalyst-x64/**/*"    Pack="true" PackagePath="build/native/maccatalyst-x64/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(VlcArtifacts)/maccatalyst-arm64/**/*"  Pack="true" PackagePath="build/native/maccatalyst-arm64/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
