<Project>
  <!--
    Wires the packaged native VLC binaries into a consuming application.

    Desktop (win-*, linux-*, osx-*) relies entirely on the NuGet
    runtimes/<rid>/native convention and needs nothing here.

    Mobile targets are staged under this package's build/native/<rid> folder and
    injected below.
  -->

  <PropertyGroup>
    <_VlcNativeRoot>$(MSBuildThisFileDirectory)native</_VlcNativeRoot>
  </PropertyGroup>

  <!-- ===================== Android ===================== -->
  <!-- Ship every libvlc/libvlccore/plugin .so into lib/<abi> of the APK. -->
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'android'">
    <AndroidNativeLibrary Include="$(_VlcNativeRoot)/android-arm64/**/*.so">
      <Abi>arm64-v8a</Abi>
      <Link>lib/arm64-v8a/%(Filename)%(Extension)</Link>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="$(_VlcNativeRoot)/android-arm/**/*.so">
      <Abi>armeabi-v7a</Abi>
      <Link>lib/armeabi-v7a/%(Filename)%(Extension)</Link>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="$(_VlcNativeRoot)/android-x64/**/*.so">
      <Abi>x86_64</Abi>
      <Link>lib/x86_64/%(Filename)%(Extension)</Link>
    </AndroidNativeLibrary>
  </ItemGroup>

  <!-- ===================== iOS / Mac Catalyst ===================== -->
  <!--
    libvlc is a static archive on these platforms and is resolved through the
    "__Internal" DllImport target, so the static libs and their plugin archives
    must be linked into the app.
  -->
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'ios' and ('$(RuntimeIdentifier)' == 'ios-arm64' or '$(RuntimeIdentifier)' == 'iossimulator-arm64' or '$(RuntimeIdentifier)' == 'iossimulator-x64')">
    <NativeReference Include="$(_VlcNativeRoot)/$(RuntimeIdentifier)/libvlc.a" Condition="Exists('$(_VlcNativeRoot)/$(RuntimeIdentifier)/libvlc.a')">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
    </NativeReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst' and ('$(RuntimeIdentifier)' == 'maccatalyst-arm64' or '$(RuntimeIdentifier)' == 'maccatalyst-x64')">
    <NativeReference Include="$(_VlcNativeRoot)/$(RuntimeIdentifier)/libvlc.a" Condition="Exists('$(_VlcNativeRoot)/$(RuntimeIdentifier)/libvlc.a')">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
    </NativeReference>
  </ItemGroup>
</Project>
