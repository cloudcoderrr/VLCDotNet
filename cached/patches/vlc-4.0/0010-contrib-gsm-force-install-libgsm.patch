From: GitHub Copilot <copilot@github.com>
Subject: [PATCH] contrib: force-install libgsm.a (gsm install flaky on Apple cross)

gsm-1.0-pl22's `gsminstall` target also installs man pages, and that step
fails under the Apple mobile / Mac Catalyst (macabi) cross toolchain
(make[1]: [gsminstall] Error 2), which leaves libgsm.a and gsm/gsm.h
uninstalled in the contrib prefix. FFmpeg's --enable-libgsm (an unconditional
VLC 4.0 dependency: DEPS_ffmpeg = ... gsm ...) then fails configure with
"ERROR: libgsm not found", breaking the whole Apple contrib build.

Ignore the gsminstall failure (the library and header are already built by
that target before the man-page step) and copy the built static library and
public header into the prefix explicitly so ffmpeg can find them. The copies
are idempotent, so this is a no-op on platforms where gsminstall succeeds.
---
--- a/contrib/src/gsm/rules.mak
+++ b/contrib/src/gsm/rules.mak
@@ -33,4 +33,6 @@ GSM_ENV := GSM_INSTALL_ROOT="$(PREFIX)" \
 .gsm: gsm
 	install -d "$(PREFIX)/lib" "$(PREFIX)/include/gsm" "$(PREFIX)/share/man/man3"
-	$(HOSTVARS_PIC) $(GSM_ENV) $(MAKE) -C $< gsminstall
+	-$(HOSTVARS_PIC) $(GSM_ENV) $(MAKE) -C $< gsminstall
+	cp "$</lib/libgsm.a" "$(PREFIX)/lib/libgsm.a"
+	cp "$</inc/gsm.h" "$(PREFIX)/include/gsm/gsm.h"
 	touch $@
