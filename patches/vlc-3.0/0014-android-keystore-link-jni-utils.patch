From: VLCDotNet CI <ci@vlcdotnet>
Subject: [PATCH] android: link the JNI utils into the file keystore plugin

On Android the file keystore compiles `keystore/file_crypt_android.c`, which
calls `android_getEnv` to reach the Android keystore via JNI. `android_getEnv`
is defined in `video_output/android/utils.c`, but the file keystore plugin does
not list it, so the build fails with `undefined symbol: android_getEnv`. Link
the util into the plugin (same approach as the opensles output in patch 0004).
---
 modules/keystore/Makefile.am | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/modules/keystore/Makefile.am b/modules/keystore/Makefile.am
--- a/modules/keystore/Makefile.am
+++ b/modules/keystore/Makefile.am
@@ -8,7 +8,9 @@ libfile_keystore_plugin_la_SOURCES = keystore/file.c \
 	keystore/file_crypt.h \
 	keystore/list_util.c keystore/list_util.h
 if HAVE_ANDROID
-libfile_keystore_plugin_la_SOURCES += keystore/file_crypt_android.c
+libfile_keystore_plugin_la_SOURCES += keystore/file_crypt_android.c \
+	video_output/android/utils.c video_output/android/utils.h
+libfile_keystore_plugin_la_CFLAGS = $(AM_CFLAGS)
+libfile_keystore_plugin_la_LIBADD = $(LIBDL)
 endif
 if HAVE_WIN32
 libfile_keystore_plugin_la_SOURCES += keystore/file_crypt_win32.c
