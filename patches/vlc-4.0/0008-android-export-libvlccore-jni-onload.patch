From: VLCDotNet CI <ci@vlcdotnet>
Subject: [PATCH] android: export libvlccore JNI_OnLoad so s_jvm is set

libvlccore JNI_OnLoad (src/android/specific.c) stores the JavaVM in the static
s_jvm that libvlc_InternalInit -> system_Configure asserts is non-NULL. JNI_OnLoad
is not listed in libvlccore.sym, so libtool -export-symbols hides it and neither
java.lang.System.loadLibrary nor an explicit dlsym can invoke it, leaving s_jvm
NULL and aborting libvlc_new on Android. Re-export JNI_OnLoad/JNI_OnUnload with an
Android-only version script referenced from the unconditional LDFLAGS via a
conditional variable (android/specific.c is not built elsewhere; adding the
symbols to libvlccore.sym would break the Windows .def and Apple
-exported_symbols_list links). An exact global match wins over libtool local
wildcard.
---
diff --git a/src/Makefile.am b/src/Makefile.am
index 869a5eb..ee2ddd6 100644
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -468,8 +468,14 @@ libvlccore_la_LDFLAGS = \
 	$(LDFLAGS_libvlccore) \
 	-no-undefined \
 	-export-symbols $(srcdir)/libvlccore.sym \
+	$(libvlccore_jni_export) \
 	-version-info 9:1:0
 libvlccore_la_DEPENDENCIES = libvlccore.sym
+if HAVE_ANDROID
+libvlccore_jni_export = -Wl,--version-script=$(srcdir)/libvlccore_jni.sym
+else
+libvlccore_jni_export =
+endif
 if HAVE_WIN32
 libvlccore_la_DEPENDENCIES += libvlc_win32_rc.$(OBJEXT)
 libvlccore_la_LDFLAGS += -Wl,libvlc_win32_rc.$(OBJEXT) -avoid-version -Wc,-static $(LIBCOM)
diff --git a/src/libvlccore_jni.sym b/src/libvlccore_jni.sym
new file mode 100644
index 0000000..2209b52
--- /dev/null
+++ b/src/libvlccore_jni.sym
@@ -0,0 +1,5 @@
+{
+  global:
+    JNI_OnLoad;
+    JNI_OnUnload;
+};
