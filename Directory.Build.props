<Project>

  <PropertyGroup>
    <!--
      The libvlc version this repository targets for the VLCDotNet3 package.
      Bump this to build a newer VLC 3.0.x release; the value flows into the
      GitHub Actions build matrix and the NuGet package version.
    -->
    <VlcVersion>3.0.23</VlcVersion>

    <!--
      VLC 4.x (preview) coordinates for the VLCDotNet4 package. 4.0.0 is not yet
      released, so the from-source and prebuilt-deps pipelines build libvlc from
      the VideoLAN git ref below, and the NuGet package uses a SemVer prerelease
      base (the pack workflow appends the running suffix -> 4.0.0-preview.N).
        VlcVersion4  package base version (also the release-tag base v<base>.N).
        VlcRef4      git ref (branch/tag/commit) the v4 build scripts check out.
      Both are overridable from CI (env VLC_REF) so a broken master HEAD can be
      pinned to a known-good commit without editing the tree.
    -->
    <VlcVersion4>4.0.0-preview</VlcVersion4>
    <VlcRef4>master</VlcRef4>

    <!--
      Selects which package a build produces. Default 3 (VLCDotNet3). CI packs
      the v4 package with -p:VlcMajor=4, which switches the package id, version,
      the VLC4 compile symbol and the bundled MSBuild targets file.
    -->
    <VlcMajor Condition="'$(VlcMajor)' == ''">3</VlcMajor>

    <!-- Common language / build settings -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Shared NuGet / assembly metadata -->
    <Company>VLCDotNet</Company>
    <Authors>VLCDotNet contributors</Authors>
    <Product>VLCDotNet</Product>
    <Copyright>Copyright (c) VLCDotNet contributors</Copyright>
    <PackageProjectUrl>https://github.com/cloudcoderrr/VLCDotNet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cloudcoderrr/VLCDotNet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>PACKAGE-LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

</Project>
