<Project>
  <!--
    Wires the packaged playback-only native VLC binaries into a consuming app.
    Identical to the full VLCDotNet3 targets: the embedded Apple framework binary
    is still named "VLCDotNet" and the native payload still lives under
    build/native/<rid>, so only the file name differs (it must match the package
    id VLCDotNet3.Playback for NuGet to auto-import it).

    Desktop (win-*, linux-*, osx-*) relies entirely on the NuGet
    runtimes/<rid>/native convention and needs nothing here.

    Mobile targets are staged under this package's build/native/<rid> folder and
    injected below.
  -->

  <PropertyGroup>
    <!--
      The native payload is packed under build/native/<rid>. This targets file
      ships in BOTH build/ (direct consumers) and buildTransitive/ (transitive
      consumers, e.g. apps that reference this package via another package or a
      project reference). Resolve the native root relative to the PACKAGE ROOT
      (../build/native) so it works from either location; using
      $(MSBuildThisFileDirectory)native resolved to the nonexistent
      buildTransitive/native for transitive consumers, so their Android .so and
      Apple framework were never wired (DllNotFoundException: libvlc / VLCDotNet).
      GetFullPath normalises away the ".." so the Android **/*.so glob (which does
      not tolerate ".." mid-path) also resolves.
    -->
    <_VlcNativeRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../build/native'))</_VlcNativeRoot>
  </PropertyGroup>

  <!-- ===================== Android ===================== -->
  <!--
    Ship every libvlc/libvlccore/plugin .so into lib/<abi> of the APK.

    Only wire the native libraries into APPLICATION builds ($(AndroidApplication)
    == 'true'). .NET for Android bundles @(AndroidNativeLibrary) items into a
    class library's generated .aar, so without this guard every intermediate
    managed wrapper (VLCDotNet3.Playback.Core, .Maui) would bake ~160 MB of
    native .so into its own package and double-ship the runtimes. The targets
    flow transitively to the final app via buildTransitive, so the app still gets
    the natives directly from this package - the same model used for the desktop
    runtimes/ assets and the iOS/Mac Catalyst framework.
  -->
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'android' and '$(AndroidApplication)' == 'true'">
    <AndroidNativeLibrary Include="$(_VlcNativeRoot)/android-arm64/**/*.so">
      <Abi>arm64-v8a</Abi>
      <Link>lib/arm64-v8a/%(Filename)%(Extension)</Link>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="$(_VlcNativeRoot)/android-arm/**/*.so">
      <Abi>armeabi-v7a</Abi>
      <Link>lib/armeabi-v7a/%(Filename)%(Extension)</Link>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="$(_VlcNativeRoot)/android-x64/**/*.so">
      <Abi>x86_64</Abi>
      <Link>lib/x86_64/%(Filename)%(Extension)</Link>
    </AndroidNativeLibrary>
  </ItemGroup>

  <!--
    Keep the DESKTOP libvlc out of the Android APK.

    This package ships desktop runtimes under runtimes/<rid>/native (linux-x64,
    linux-arm64, ...) for Win/Linux/macOS consumers, and the Android binaries
    separately under build/native/android-<abi> (wired above). Older .NET for
    Android SDKs (e.g. the 36.1.2 band shipped with the net10 MAUI workload)
    resolve native libraries purely by the architecture token of the runtimes/
    RID folder: runtimes/linux-arm64 -> arm64-v8a and runtimes/linux-x64 ->
    x86_64. That pulls the GLIBC/desktop libvlc.so into lib/<abi> of the APK and
    then drops the real Android libvlc.so as a duplicate (warning XA4301), so the
    app loads a non-Android binary and fails with
    "System.DllNotFoundException: libvlc" at runtime.

    Remove every non-Android runtimes/ native .so from the publish set before the
    SDK collects native libraries into the APK. Android's own libvlc comes from
    build/native/android-* (AndroidNativeLibrary above); both 'android-*' and
    'linux-bionic-*' RIDs are legitimate Android targets and are preserved. This
    mirrors the later upstream fix in
    Microsoft.Android.Sdk.AssemblyResolution.targets so the package is correct on
    SDKs that predate it.
  -->
  <Target Name="_VlcRemoveDesktopNativeLibrariesFromAndroidApk"
          Condition="'$(TargetPlatformIdentifier)' == 'android' and '$(AndroidApplication)' == 'true'"
          BeforeTargets="_IncludeNativeSystemLibraries">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(Extension)' == '.so'
                     And $([System.String]::Copy('%(Identity)').Replace('\','/').Contains('/runtimes/'))
                     And !$([System.String]::Copy('%(Identity)').Replace('\','/').Contains('/runtimes/android'))
                     And !$([System.String]::Copy('%(Identity)').Replace('\','/').Contains('/runtimes/linux-bionic'))" />
    </ItemGroup>
  </Target>

  <!-- ===================== iOS / Mac Catalyst ===================== -->
  <!--
    libvlc ships as a signed, embedded *dynamic* framework
    (VLCDotNet.framework/VLCDotNet) built by stage_dynamic_vlc: one Mach-O that
    bundles libvlc + libvlccore + every plugin/contrib archive and force-loads
    the generated vlc_static_modules[] table internally, resolving all system
    frameworks at link time. The consumer links it *dynamically* via a single
    NativeReference (Kind=Framework). The DllImport target name is the framework
    binary ("VLCDotNet").
  -->
  <PropertyGroup Condition="('$(TargetPlatformIdentifier)' == 'ios' or '$(TargetPlatformIdentifier)' == 'maccatalyst') and Exists('$(_VlcNativeRoot)/$(RuntimeIdentifier)/VLCDotNet.framework')">
    <_VlcRid>$(_VlcNativeRoot)/$(RuntimeIdentifier)</_VlcRid>
  </PropertyGroup>

  <ItemGroup Condition="('$(TargetPlatformIdentifier)' == 'ios' or '$(TargetPlatformIdentifier)' == 'maccatalyst') and Exists('$(_VlcNativeRoot)/$(RuntimeIdentifier)/VLCDotNet.framework')">
    <NativeReference Include="$(_VlcRid)/VLCDotNet.framework">
      <Kind>Framework</Kind>
      <SmartLink>False</SmartLink>
    </NativeReference>
  </ItemGroup>
</Project>
