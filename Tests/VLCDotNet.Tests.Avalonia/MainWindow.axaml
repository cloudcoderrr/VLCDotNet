<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VLCDotNet.Tests.Avalonia"
        x:Class="VLCDotNet.Tests.Avalonia.MainWindow"
        Width="1040" Height="680"
        Title="VLCDotNet — Desktop Test Runner">

  <Window.Resources>
    <local:StatusColorConverter x:Key="StatusColor" />
  </Window.Resources>

  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,10">
      <Button x:Name="RunButton" Content="Run all tests" Click="OnRunClick" />
      <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Text="Ready." />
    </StackPanel>

    <Grid ColumnDefinitions="1.1*,1.4*">
      <Border Grid.Column="0" BorderBrush="#22000000" BorderThickness="1" CornerRadius="4">
        <ListBox x:Name="ResultsList" SelectionChanged="OnSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Status}" Width="44" FontFamily="Consolas,monospace"
                           FontWeight="Bold" Foreground="{Binding Converter={StaticResource StatusColor}}" />
                <TextBlock Text="{Binding Category}" Width="80" Opacity="0.7" />
                <TextBlock Text="{Binding Name}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Grid Grid.Column="1" Margin="12,0,0,0" RowDefinitions="Auto,*,Auto">
        <TextBlock x:Name="DetailTitle" Grid.Row="0" FontWeight="Bold" Margin="0,0,0,6" />
        <TextBox x:Name="DetailText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" FontFamily="Consolas,monospace" />
        <Border Grid.Row="2" Height="220" Margin="0,8,0,0" Background="#11000000" CornerRadius="4">
          <Image x:Name="SnapshotImage" Stretch="Uniform" Margin="4" />
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
