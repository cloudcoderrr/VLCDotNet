<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VLCDotNet.Tests.Maui.MainPage"
             Title="VLCDotNet Mobile Tests">
  <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="8">
    <Button x:Name="RunButton" Grid.Row="0" Text="Run all tests" Clicked="OnRunClicked" />
    <Label x:Name="SummaryLabel" Grid.Row="1" Text="Ready." />
    <CollectionView x:Name="ResultsView" Grid.Row="2">
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="54,92,*" Padding="2,4">
            <Label Grid.Column="0" Text="{Binding Status}" FontAttributes="Bold" />
            <Label Grid.Column="1" Text="{Binding Category}" TextColor="Gray" />
            <Label Grid.Column="2" Text="{Binding Name}" LineBreakMode="TailTruncation" />
          </Grid>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </Grid>
</ContentPage>
