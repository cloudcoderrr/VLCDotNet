<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      iOS and Mac Catalyst can only be restored/built on macOS (they need the
      Apple SDK workload packs). Restricting the TFM list by host OS lets the
      Android head build on Linux CI without pulling the Microsoft.iOS.Sdk pack,
      which restore would otherwise demand for every listed TFM.
    -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX'))">net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <ApplicationTitle>VLCDotNet Tests</ApplicationTitle>
    <ApplicationId>com.vlcdotnet.tests</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Ensure referenced binding/shared projects expose the mobile heads. -->
    <VlcMobileTargets>true</VlcMobileTargets>

    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-ios'">12.2</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-maccatalyst'">13.1</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">21.0</SupportedOSPlatformVersion>
    <!-- Android requires the native .so to be extractable for VLC plugin scanning. -->
    <AndroidExtractNativeLibs Condition="'$(TargetFramework)' == 'net10.0-android'">true</AndroidExtractNativeLibs>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <!-- Bundle the synthetic media pack so tests can stage it to app storage. -->
    <MauiAsset Include="..\Data\vlc_test_pack\*.*" LogicalName="vlc_test_pack/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VLCDotNet.Tests.Shared\VLCDotNet.Tests.Shared.csproj" />
  </ItemGroup>

  <!--
    CI injects the built native libvlc here (Tests/.../native/<rid>) so the MAUI
    heads can be tested without first publishing the NuGet. Android .so files are
    flattened into lib/<abi>; iOS/Catalyst link the static libvlc archive.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <AndroidNativeLibrary Include="$(MSBuildThisFileDirectory)native/android-arm64/**/*.so" Condition="Exists('$(MSBuildThisFileDirectory)native/android-arm64')">
      <Abi>arm64-v8a</Abi>
      <Link>lib/arm64-v8a/%(Filename)%(Extension)</Link>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="$(MSBuildThisFileDirectory)native/android-x64/**/*.so" Condition="Exists('$(MSBuildThisFileDirectory)native/android-x64')">
      <Abi>x86_64</Abi>
      <Link>lib/x86_64/%(Filename)%(Extension)</Link>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="$(MSBuildThisFileDirectory)native/android-arm/**/*.so" Condition="Exists('$(MSBuildThisFileDirectory)native/android-arm')">
      <Abi>armeabi-v7a</Abi>
      <Link>lib/armeabi-v7a/%(Filename)%(Extension)</Link>
    </AndroidNativeLibrary>
  </ItemGroup>

  <!--
    iOS / simulator / Mac Catalyst statically link libvlc. Link libvlc.a +
    libvlccore.a + every plugin/contrib archive under static/, and force-load
    libvlcstaticmodules.a (the generated vlc_static_modules[] table) so the
    statically linked plugins get registered. The plugins pull the system
    frameworks/libraries they reference.
  -->
  <PropertyGroup Condition="('$(TargetFramework)' == 'net10.0-ios' or '$(TargetFramework)' == 'net10.0-maccatalyst')">
    <_VlcRidDir>$(MSBuildThisFileDirectory)native/$(RuntimeIdentifier)</_VlcRidDir>
    <MtouchExtraArgs Condition="Exists('$(_VlcRidDir)/static')">$(MtouchExtraArgs) -gcc_flags "-lc++ -lbz2 -liconv -lz"</MtouchExtraArgs>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios' and Exists('$(_VlcRidDir)/static')">
    <NativeReference Include="$(_VlcRidDir)/libvlc.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <Frameworks>Foundation CoreFoundation CFNetwork UIKit CoreGraphics CoreText QuartzCore CoreMedia CoreVideo CoreAudio AudioToolbox AVFoundation VideoToolbox OpenGLES Security SystemConfiguration</Frameworks>
    </NativeReference>
    <NativeReference Include="$(_VlcRidDir)/libvlccore.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
    </NativeReference>
    <NativeReference Include="$(_VlcRidDir)/static/libvlcstaticmodules.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
    </NativeReference>
    <NativeReference Include="$(_VlcRidDir)/static/*.a" Exclude="$(_VlcRidDir)/static/libvlcstaticmodules.a">
      <Kind>Static</Kind>
      <ForceLoad>false</ForceLoad>
    </NativeReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-maccatalyst' and Exists('$(_VlcRidDir)/static')">
    <NativeReference Include="$(_VlcRidDir)/libvlc.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <Frameworks>Foundation CoreFoundation CFNetwork AppKit CoreGraphics CoreText QuartzCore CoreMedia CoreVideo CoreAudio AudioToolbox AVFoundation VideoToolbox Security SystemConfiguration</Frameworks>
    </NativeReference>
    <NativeReference Include="$(_VlcRidDir)/libvlccore.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
    </NativeReference>
    <NativeReference Include="$(_VlcRidDir)/static/libvlcstaticmodules.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
    </NativeReference>
    <NativeReference Include="$(_VlcRidDir)/static/*.a" Exclude="$(_VlcRidDir)/static/libvlcstaticmodules.a">
      <Kind>Static</Kind>
      <ForceLoad>false</ForceLoad>
    </NativeReference>
  </ItemGroup>

  <ItemGroup Condition="('$(TargetFramework)' == 'net10.0-ios' or '$(TargetFramework)' == 'net10.0-maccatalyst') and Exists('$(_VlcRidDir)/static/static-modules.txt')">
    <MauiAsset Include="$(_VlcRidDir)/static/static-modules.txt" LogicalName="static-modules.txt" />
  </ItemGroup>


</Project>
