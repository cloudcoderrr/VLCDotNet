<?xml version="1.0" encoding="utf-8"?>
<!--
  Scopes NuGet restore for every project under Maui/ (the new Core/Avalonia/MAUI
  packages and their test apps).

  The new packages take a PackageReference on VLCDotNet3.Playback, which is not
  published to nuget.org - it ships only as a GitHub Release asset. The local
  folder feed below is populated (locally and in CI) by downloading that nupkg
  with the gh CLI (release vplay3-3.0.24.1, pattern *.nupkg) into Maui/.local-nuget.

  The .local-nuget folder is git-ignored so the large native package is never
  committed.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="vlcdotnet-local" value=".local-nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="vlcdotnet-local">
      <package pattern="VLCDotNet3.Playback" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
