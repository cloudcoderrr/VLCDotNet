<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MAUI test app for the VLCDotNet3.Playback view packages. Runs the shared
    high-level suite plus a MAUI VideoView render test on Android, iOS and Mac
    Catalyst (AUTORUN mode for CI). Native libvlc is delivered transitively by
    the VLCDotNet3.Playback.Core -> VLCDotNet3.Playback package chain, exactly as
    a real consumer would get it (no manual native injection).
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX'))">net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <ApplicationTitle>VLCDotNet View Tests</ApplicationTitle>
    <ApplicationId>com.vlcdotnet.viewtests</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Ensure referenced Core/Shared projects expose the mobile heads. -->
    <VlcMobileTargets>true</VlcMobileTargets>

    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-ios'">12.2</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">21.0</SupportedOSPlatformVersion>
    <!-- Android requires the native .so to be extractable for VLC plugin scanning. -->
    <AndroidExtractNativeLibs Condition="'$(TargetFramework)' == 'net10.0-android'">true</AndroidExtractNativeLibs>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <!-- Bundle the shared media pack so tests can stage it to app storage. -->
    <MauiAsset Include="..\..\..\Tests\Data\vlc_test_pack\*.*" LogicalName="vlc_test_pack/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VLCDotNet.Maui\VLCDotNet.Maui.csproj" />
    <ProjectReference Include="..\VLCDotNet.ViewTests.Shared\VLCDotNet.ViewTests.Shared.csproj" />
  </ItemGroup>

</Project>
